# Dependencias / entornos
node_modules/
.venv/
__pycache__/
*.pyc
.setup.log
engine-remotion/out/
engine-remotion/build/
engine-remotion/public/clientes
engine-remotion/public/library

# Librería descargable (se reconstruye con ./ve setup)
library/sfx/_dl/
library/sfx/kenney/
library/sfx/synth/
library/sfx/*/
!library/sfx/.gitkeep
library/music/
library/fonts/
library/index.json
library/credits.json

# Trabajo intermedio de cada proyecto (pesado). Se versiona solo lo que documenta decisiones.
clientes/**/_work/*
!clientes/**/_work/overlays*.json
!clientes/**/_work/PLAN.md
!clientes/**/_work/EDL.md
!clientes/**/_work/edl_overrides.json
!clientes/**/_work/BROLL_CATALOG.md

# Proyecto demo sintético (solo para pruebas del pipeline)
clientes/demo/

# Material pesado del cliente (queda en Drive; se re-descarga con ./ve fetch)
clientes/*/crudos_*/
clientes/*/_tanda*/
clientes/*/marca/pdf/
clientes/*/marca/pages/
clientes/*/marca/img/
clientes/*/proyectos/*/referencias/*.mp4
!clientes/**/_work/make_overlays.py
!clientes/**/_work/edl.json
