{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup.sh\" 2>&1 | tail -20",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "env": {
    "REMOTION_GL": "swangle"
  },
  "permissions": {
    "allow": [
      "Bash(./ve:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(npx remotion:*)",
      "Bash(npx hyperframes:*)",
      "Bash(npx --yes hyperframes:*)",
      "Bash(node engine-remotion/scripts/*)",
      "Bash(.venv/bin/python:*)"
    ]
  }
}